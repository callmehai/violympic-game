# ===== Server =====
PORT=4000

# Bí mật ký JWT (login + question_token). Đổi giá trị này khi deploy thật.
APP_SECRET=doi-secret-nay-truoc-khi-chay-that

# Khóa đăng nhập trang Admin.
ADMIN_KEY=admin-doi-key

# Event hiện tại.
EVENT_ID=violympic-2026-06
EVENT_DATE=2026-06-25

# Luật chơi.
TIME_LIMIT_S=300             # tổng thời gian 1 phiên (giây) — 5 phút
QUESTIONS_PER_SESSION=18     # mỗi phiên chỉ random N câu (0 = phát hết bộ đề)
BOARD_ROWS=6
BOARD_COLS=6
WRONG_TIME_PENALTY_S=0       # phạt thời gian khi trả lời sai (giây)
FAST_ANSWER_MS=10000         # trả lời nhanh hơn mốc này (ms) được thưởng tốc độ — 10 giây
FAST_ANSWER_BONUS=5
END_ON_CHEST=false           # true = đào trúng rương là kết thúc luôn
ALLOW_REPLAY=false           # true = cho phép chơi lại (bỏ ràng buộc 1 phiên/người) — áp dụng cả 2 game

# Luật Game 2 "Vượt Ải Trí Tuệ" (MÊ CUNG 2D — cửa theo độ khó, điểm câu 100/200/300).
MOUNTAIN_TIME_LIMIT_S=300         # giới hạn thời gian cả hành trình (giây) — 5 phút
MOUNTAIN_SPEED_BONUS_MAX=8        # thưởng tốc độ tối đa mỗi câu (giảm dần về 0 trong FAST_ANSWER_MS)
MOUNTAIN_FINISH_BASE=50           # thưởng nền khi tới kho báu
MOUNTAIN_FINISH_TIME_BONUS=1000   # thưởng đích theo % thời gian còn lại (mỗi giây chưa về đích ≈ mất 1000/TIME_LIMIT điểm)

# Đường dẫn DB (tương đối với thư mục server).
DB_PATH=./data/violympic.db

# ===== Client (Vite) =====
# Để trống khi chạy dev (dùng proxy của Vite). Đặt URL tuyệt đối nếu client/server khác origin.
VITE_API_BASE=
